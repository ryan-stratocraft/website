{
  "emulators": {
    "apphosting": {
      "port": 5002,
      "rootDirectory": "./",
      "startCommand": "npm run dev"
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "hosting": {
      "port": 5000
    },
    "pubsub": {
      "port": 8085
    },
    
    "eventarc": {
      "port": 9299
    },
    "tasks": {
      "port": 9499
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "webfunc",
      "codebase": "webfunc",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": [
    {
      "site": "strato-craft-6c348",
      "public": "dist",
      "predeploy": ["npm run build:all"],
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/oneura/privacy-policy",
          "destination": "https://oneura.app/privacy-policy",
          "type": 301
        },
        {
          "source": "/oneura/terms-and-conditions",
          "destination": "https://oneura.app/terms-and-conditions",
          "type": 301
        },
        {
          "source": "/oneura/cookie-policy",
          "destination": "https://oneura.app/cookie-policy",
          "type": 301
        },
        {
          "source": "/oneura/refund-policy",
          "destination": "https://oneura.app/refund-policy",
          "type": 301
        },
        {
          "source": "/oneura",
          "destination": "https://oneura.app/",
          "type": 301
        },
        {
          "source": "/oneura/**",
          "destination": "https://oneura.app/:splat",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "oneura-web",
      "public": "dist-oneura",
      "cleanUrls": true,
      "ignore": [
        "firebase.json",
        "**/.*",
        "!**/.well-known/**",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "llms.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ]
        },
        {
          "source": ".well-known/llms.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  
  
  "extensions": {},
  "database": {
    "rules": "database.rules.json"
  }
}
